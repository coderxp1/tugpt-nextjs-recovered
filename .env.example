# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Draft Generation — Langdock (sole provider, see ADR-006)
# LANGDOCK_API_CODE is required when ai_draft_generation is enabled.
# LANGDOCK_ENDPOINT_URL is optional (defaults to https://api.langdock.com/openai/eu/v1).
#
# MODEL SELECTION is two variables with a precedence, resolved at worker boot
# (apps/worker/src/draft-orchestrator-factory.ts):
#
#   LANGDOCK_MODELS  Ordered, comma-separated rotation list, cheapest first.
#                    RECOMMENDED, and what production runs. On a per-model
#                    quota rejection the next model is tried in the same
#                    attempt.
#   LANGDOCK_MODEL   Pins ONE model and DISABLES rotation. Escape hatch only.
#                    Ignored when LANGDOCK_MODELS is also set; the worker logs
#                    that it was superseded rather than swallowing it.
#   Neither set      The whole allowlist rotates.
#
# Allowed values (enforced in code, validated at worker boot):
#   gpt-5-mini   (default, cost-conscious)
#   gpt-5.1
#   gpt-5.2
#   gpt-5
# Every other model Langdock offers (o3, o4-mini, gpt-5.4*, gpt-5.5,
# gpt-5.6-*, gpt-5.2-pro, langdock-llama-3.3-70b-2) is forbidden on cost
# grounds and is rejected at boot, even if this variable names it.
#
# There is NO 'auto' value. Langdock's OpenAI-compatible endpoint returns
# HTTP 400 invalid_request_error for it — verified against the live API on
# 2026-08-19. Do not reintroduce it.
LANGDOCK_API_CODE=
LANGDOCK_ENDPOINT_URL=
LANGDOCK_MODELS=gpt-5-mini,gpt-5.1,gpt-5.2,gpt-5
# LANGDOCK_MODEL=gpt-5-mini   # uncomment ONLY to pin one model and disable rotation

# Mastra AI Orchestration
GATEWAY_API_MASTRA_KEY=
GATEWAY_API_URL=

# IONOS AI Assistant API
IONOS_API_KEY=

# HubSpot CRM API
HUBSPOT_API_KEY=

# WhatsApp Webhook Integration
#
# Both of the first two must be non-empty before `whatsapp_integration` is
# enabled. They are left blank here on purpose — there is no safe placeholder
# for a shared secret — and the webhook route refuses every request while
# either is missing, logging which one. Blank is therefore a working
# configuration only for as long as the flag is off.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MAX_BODY_SIZE_BYTES=1048576

# NOTE: Logicc and Anymize are NOT configured here. Both were removed from
# TuGPT on 2026-08-18 (Logicc: cost; Anymize: cross-project isolation — see
# ADR-006). Their adapter code remains in the repo
# (packages/ai-providers/src/{logicc,anymize}.ts) but is not imported by
# production wiring and requires no environment variables. Do not add
# LOGICC_* or ANYMIZE_* variables here without a separate, explicit
# decision reversing that removal.

# Draft Worker Configuration
DRAFT_WORKER_POLL_INTERVAL_MS=5000
DRAFT_WORKER_VISIBILITY_TIMEOUT_SECONDS=30

# Worker Configuration
WORKER_POLL_INTERVAL_MS=5000
WORKER_VISIBILITY_TIMEOUT_SECONDS=30
WORKER_MAX_ATTEMPTS=5

# --- Secret storage (migration 20260903000003) -------------------------------
# Keys for encrypting credentials in platform_secrets / organization_secrets.
# The DATABASE HOLDS NO KEY: the application encrypts and the database stores
# ciphertext, so a full dump is inert without these.
#
# Name:  TUGPT_SECRET_KEY_<ID>, where <ID> lowercased with _ -> . is the key_id
#        written on each row. TUGPT_SECRET_KEY_PLATFORM_V1 -> "platform.v1".
# Value: base64 of exactly 32 random bytes. Generate with
#        openssl rand -base64 32
#
# Keep platform and organization keys separate (platform.* and org.*). It
# limits the blast radius of one key, and it is what lets the per-table
# UNIQUE (key_id, iv) nonce guard be sufficient.
#
# Several may be set at once: that is how rotation works — write under the new
# id, re-encrypt the rows still on the old one, then remove the old variable.
TUGPT_SECRET_KEY_PLATFORM_V1=
TUGPT_SECRET_KEY_ORG_V1=

# --- Voice transcription (Gladia) --------------------------------------------
# THERE IS NO GLADIA_API_KEY VARIABLE, DELIBERATELY.
#
# The Gladia key lives in `platform_secrets` (migration 20260903000003),
# encrypted under TUGPT_SECRET_KEY_PLATFORM_V1 above, as provider 'gladia' /
# secret_name 'api_key'. That is the whole reason secret storage was built
# before this adapter: putting the key here would mean writing the code that
# reads it from the environment and then rewriting that code, with the interim
# version being the one that ships.
#
# If you are here because you have a key and want somewhere to put it, there is
# a command for that — it prompts with echo off, so the value never reaches
# shell history, argv, or any log:
#
#   docker compose -p tugpt run --rm -it draft-worker \
#     node dist/secrets-cli.js put --provider gladia --secret-name api_key
#
# Adding a variable here instead will not be read by anything.
#
# Turning the capability on is a database change too, not a deploy: the global
# and per-organization `voice_transcription` feature flags both ship false
# (migration 20260903000004) and both must be true for any call to be made.

# --- Meta Graph media access -------------------------------------------------
# THERE IS NO GRAPH ACCESS TOKEN VARIABLE EITHER, for the same reason.
#
# The transcription worker downloads inbound voice notes from Meta's Graph
# media endpoint before it can hand anything to Gladia, and that needs a Graph
# access token — a credential this repo never had. WHATSAPP_APP_SECRET and
# WHATSAPP_VERIFY_TOKEN above are inbound-webhook only and cannot fetch media.
#
# It lives in `platform_secrets` as provider 'meta' / secret_name
# 'graph_access_token', installed the same way:
#
#   docker compose -p tugpt run --rm -it draft-worker \
#     node dist/secrets-cli.js put --provider meta --secret-name graph_access_token
#
# READ-ONLY BY CONSTRUCTION. The client that holds this token issues GET
# requests to two endpoints and has no code path that POSTs; the
# `whatsapp_integration` outbound gate is untouched, and
# apps/worker/tests/outbound-gate.test.ts asserts that against the source.

# --- Transcription worker ----------------------------------------------------
# The visibility timeout is 120s rather than the draft worker's 30s: an attempt
# downloads media and then waits on Gladia for up to 300s, and a lease that
# expires mid-wait hands the same job to a second worker while the first is
# still legitimately waiting — which Gladia bills for twice.
TRANSCRIPTION_WORKER_POLL_INTERVAL_MS=5000
TRANSCRIPTION_WORKER_VISIBILITY_TIMEOUT_SECONDS=120

# Hard ceiling on one inbound voice note, in bytes. Default 8388608 (8 MiB),
# under Meta's own 16 MiB audio limit.
#
# This is a spend control, not a storage one: Gladia bills per second of audio,
# and bytes are the only proxy for duration available before decoding. At
# WhatsApp's opus bitrate 8 MiB is well over half an hour — far beyond any real
# voice note. Enforced twice: against the size Meta declares, before any
# transfer, and against the bytes actually arriving, which cannot be lied to.
TRANSCRIPTION_MAX_MEDIA_BYTES=8388608
